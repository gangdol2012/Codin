{
  "name": "codecraft-ide",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "prepare": "node scripts/build-minimal-typeshed.mjs && node scripts/sync-browser-csharp-runtime.mjs && node scripts/sync-intellisage-runtime.mjs",
    "postinstall": "node scripts/sync-browser-csharp-runtime.mjs && node scripts/sync-intellisage-runtime.mjs",
    "prebuild": "node scripts/build-minimal-typeshed.mjs && node scripts/sync-browser-csharp-runtime.mjs && node scripts/sync-intellisage-runtime.mjs",
    "csharp:intellisage:publish": "dotnet publish vendor/intellisage-wasm/Intellisage.csproj -c Release",
    "dev": "vite",
    "build": "vite build",
    "lint": "node --stack-size=8192 ./node_modules/.bin/tsc --noEmit",
    "preview": "vite preview"
  },
  "dependencies": {
    "@google/genai": "^1.29.0",
    "@monaco-editor/react": "^4.7.0",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tailwindcss/typography": "^0.5.19",
    "@wasmer/sdk": "^0.10.0",
    "browser-csharp": "^1.1.2",
    "clsx": "^2.1.1",
    "flexlayout-react": "^0.8.19",
    "lucide-react": "^0.475.0",
    "monaco-editor": "^0.52.2",
    "monaco-pyright-lsp": "^0.1.7",
    "motion": "^12.4.2",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-markdown": "^10.1.0",
    "tailwind-merge": "^3.0.1",
    "tailwindcss": "^4.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  }
}
