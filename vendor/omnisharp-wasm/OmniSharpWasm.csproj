<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <WasmEnableWebcil>false</WasmEnableWebcil>
    <RootNamespace>CodeCraft.OmniSharpWasm</RootNamespace>
  </PropertyGroup>

  <PropertyGroup>
    <NoWarn>CS0436</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <PublishDir>publish/</PublishDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="8.0.4" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="8.0.4" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Common" Version="4.9.2" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Features" Version="4.9.2" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="4.9.2" />
    <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.Common" Version="4.9.2" />
    <PackageReference Include="OmniSharp.Roslyn.CSharp" Version="1.37.4" />
    <PackageReference Include="Tewr.BlazorWorker.BackgroundService" Version="4.1.2" />
    <PackageReference Include="Tewr.BlazorWorker.Core" Version="4.2.0" />
    <PackageReference Include="Tewr.BlazorWorker.Extensions.JSRuntime" Version="4.1.3" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Example/**/*.cs" />
    <Content Remove="publish/**" />
    <None Remove="publish/**" />
  </ItemGroup>

  <Target Name="PublishOmniSharpReferencePack">
    <ItemGroup>
      <_OmniSharpNetCoreTargetingPack
        Include="@(ResolvedTargetingPack)"
        Condition="'%(ResolvedTargetingPack.Identity)' == 'Microsoft.NETCore.App'" />
      <_OmniSharpReferenceAssembly
        Include="%(_OmniSharpNetCoreTargetingPack.PackageDirectory)/ref/$(TargetFramework)/*.dll" />
    </ItemGroup>

    <PropertyGroup>
      <OmniSharpReferencePackDirectory>$(PublishDir)wwwroot/_framework/ref</OmniSharpReferencePackDirectory>
    </PropertyGroup>

    <Error
      Condition="'@(_OmniSharpNetCoreTargetingPack)' == ''"
      Text="Could not resolve the Microsoft.NETCore.App targeting pack for $(TargetFramework)." />
    <Error
      Condition="'@(_OmniSharpReferenceAssembly)' == ''"
      Text="The Microsoft.NETCore.App targeting pack contains no $(TargetFramework) reference assemblies." />

    <!-- This is a publish-time staging directory, not a runtime asset surface. Removing
         it before each index pass prevents stale DLLs from a previous SDK patch from
         entering the deterministic pack. The post-index target removes it again so the
         static deployment does not retain a second loose copy of the complete pack. -->
    <RemoveDir Directories="$(OmniSharpReferencePackDirectory)" />
    <MakeDir Directories="$(OmniSharpReferencePackDirectory)" />
    <Copy
      SourceFiles="@(_OmniSharpReferenceAssembly)"
      DestinationFolder="$(OmniSharpReferencePackDirectory)"
      SkipUnchangedFiles="true" />
  </Target>

  <Target
    Name="PatchRoslynPersistentStorageForBrowser"
    AfterTargets="Publish"
    DependsOnTargets="PublishOmniSharpReferencePack">
    <PropertyGroup>
      <RoslynWorkspacesAssembly>$(PublishDir)wwwroot/_framework/Microsoft.CodeAnalysis.Workspaces.dll</RoslynWorkspacesAssembly>
      <RoslynBrowserStoragePatcher>$(MSBuildProjectDirectory)/../../tools/RoslynBrowserStoragePatcher/RoslynBrowserStoragePatcher.csproj</RoslynBrowserStoragePatcher>
      <OmniSharpNamespaceIndexer>$(MSBuildProjectDirectory)/../../tools/OmniSharpNamespaceIndexer/OmniSharpNamespaceIndexer.csproj</OmniSharpNamespaceIndexer>
      <OmniSharpFrameworkDirectory>$(PublishDir)wwwroot/_framework</OmniSharpFrameworkDirectory>
      <OmniSharpReferencePackDirectory>$(OmniSharpFrameworkDirectory)/ref</OmniSharpReferencePackDirectory>
      <OmniSharpNamespaceIndex>$(OmniSharpFrameworkDirectory)/codecraft-namespace-index.json</OmniSharpNamespaceIndex>
    </PropertyGroup>

    <Exec
      Condition="Exists('$(RoslynWorkspacesAssembly)')"
      Command="dotnet run --project &quot;$(RoslynBrowserStoragePatcher)&quot; -- &quot;$(RoslynWorkspacesAssembly)&quot;" />

    <Exec
      Condition="Exists('$(OmniSharpReferencePackDirectory)')"
      Command="dotnet run --project &quot;$(OmniSharpNamespaceIndexer)&quot; -- &quot;$(OmniSharpReferencePackDirectory)&quot; &quot;$(OmniSharpNamespaceIndex)&quot;" />

    <!-- The indexer writes the packed binary and manifest outside this staging directory.
         Remove loose DLLs only after a successful Exec; a failed index keeps its inputs for
         diagnosis and fails publish before an incomplete static artifact can be shipped. -->
    <RemoveDir
      Directories="$(OmniSharpReferencePackDirectory)"
      Condition="Exists('$(OmniSharpReferencePackDirectory)')" />
  </Target>

</Project>
