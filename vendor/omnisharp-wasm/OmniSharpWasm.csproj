<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <WasmEnableWebcil>false</WasmEnableWebcil>
    <RootNamespace>CodeCraft.OmniSharpWasm</RootNamespace>
  </PropertyGroup>

  <PropertyGroup>
    <NoWarn>CS0436</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <PublishDir>publish/</PublishDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="8.0.4" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="8.0.4" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Common" Version="4.9.2" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Features" Version="4.9.2" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="4.9.2" />
    <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.Common" Version="4.9.2" />
    <PackageReference Include="OmniSharp.Roslyn.CSharp" Version="1.37.4" />
    <PackageReference Include="Tewr.BlazorWorker.BackgroundService" Version="4.1.2" />
    <PackageReference Include="Tewr.BlazorWorker.Core" Version="4.2.0" />
    <PackageReference Include="Tewr.BlazorWorker.Extensions.JSRuntime" Version="4.1.3" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Example/**/*.cs" />
    <Content Remove="publish/**" />
    <None Remove="publish/**" />
  </ItemGroup>

  <Target Name="PatchRoslynPersistentStorageForBrowser" AfterTargets="Publish">
    <PropertyGroup>
      <RoslynWorkspacesAssembly>$(PublishDir)wwwroot/_framework/Microsoft.CodeAnalysis.Workspaces.dll</RoslynWorkspacesAssembly>
      <RoslynBrowserStoragePatcher>$(MSBuildProjectDirectory)/../../tools/RoslynBrowserStoragePatcher/RoslynBrowserStoragePatcher.csproj</RoslynBrowserStoragePatcher>
      <OmniSharpNamespaceIndexer>$(MSBuildProjectDirectory)/../../tools/OmniSharpNamespaceIndexer/OmniSharpNamespaceIndexer.csproj</OmniSharpNamespaceIndexer>
      <OmniSharpFrameworkDirectory>$(PublishDir)wwwroot/_framework</OmniSharpFrameworkDirectory>
    </PropertyGroup>

    <Exec
      Condition="Exists('$(RoslynWorkspacesAssembly)')"
      Command="dotnet run --project &quot;$(RoslynBrowserStoragePatcher)&quot; -- &quot;$(RoslynWorkspacesAssembly)&quot;" />

    <Exec
      Condition="Exists('$(OmniSharpFrameworkDirectory)')"
      Command="dotnet run --project &quot;$(OmniSharpNamespaceIndexer)&quot; -- &quot;$(OmniSharpFrameworkDirectory)&quot;" />
  </Target>

</Project>
